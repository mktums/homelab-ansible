[Unit]
Description=Kopia repository verification (daily 5% sample)

[Service]
Type=oneshot
Environment=KOPIA_PASSWORD={{ kopia_repo_password }}
ExecStart=/usr/bin/kopia snapshot verify \
  --config-file={{ kopia_config_dir }}/repository.config \
  --verify-files-percent=5 \
  --file-parallelism=4 \
  --parallel=4
