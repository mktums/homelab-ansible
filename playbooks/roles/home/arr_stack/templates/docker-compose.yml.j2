services:
  radarr:
    image: "{{ arr_radarr_image }}:{{ arr_radarr_tag }}"
    restart: unless-stopped
    environment:
      PUID: "{{ container_puid | string }}"
      PGID: "{{ container_pgid | string }}"
      TZ: "{{ timezone }}"
    volumes:
      - "{{ arr_stack_data_dir }}/radarr:/config"
      - "/mnt/data:/data"
      - /etc/localtime:/etc/localtime:ro
      - /etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
    ports:
      - "{{ arr_radarr_port }}:7878"
    labels:
      traefik.enable: "true"
      traefik.http.routers.radarr.rule: "Host(`{{ arr_radarr_cname }}.{{ lan_domain }}`)"
      traefik.http.routers.radarr.entrypoints: "websecure"
      traefik.http.routers.radarr.tls: "true"
      traefik.http.routers.radarr.tls.certresolver: "step-ca"
      traefik.http.services.radarr.loadbalancer.server.port: "7878"
      homepage.group: "Media"
      homepage.name: "Radarr"
      homepage.icon: "sh-radarr"
      homepage.href: "https://{{ arr_radarr_cname }}.{{ lan_domain }}"
      homepage.description: "Movie manager"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null --timeout=3 --no-check-certificate http://localhost:7878/ || exit 1"]
      start_period: 30s
      interval: 30s
      timeout: 5s
      retries: 3

